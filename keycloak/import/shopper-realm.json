{
  "realm": "shopper",
  "displayName": "Shopper",
  "enabled": true,
  "sslRequired": "none",

  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,

  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "bruteForceProtected": true,

  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Full access to Shopper resources"
      },
      {
        "name": "USER",
        "description": "Access only to the user's own resources"
      }
    ]
  },

  "clients": [
    {
      "clientId": "authentication-service",
      "name": "Authentication Service",
      "description": "Client used for login, refresh and user management",
      "enabled": true,
      "protocol": "openid-connect",

      "clientAuthenticatorType": "client-secret",
      "secret": "${AUTH_SERVICE_CLIENT_SECRET}",

      "publicClient": false,
      "bearerOnly": false,

      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,

      "fullScopeAllowed": true,

      "protocolMappers": [
        {
          "name": "user-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "userId",
            "claim.name": "userId",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        }
      ],

      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],

      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },

    {
      "clientId": "user-service",
      "name": "User Service",
      "description": "Resource server protected by Keycloak JWT",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "bearerOnly": true,

      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],

  "users": [
    {
      "username": "service-account-authentication-service",
      "enabled": true,
      "serviceAccountClientId": "authentication-service",

      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    }
  ]
}
